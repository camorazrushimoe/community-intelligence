# Community Intelligence — environment template.
# Copy to .env and adjust. These connection strings are how agents reach the
# project's services on the foundation's generic dev-env / staging-env networks.

# --- Databases (reachable by service name on the networks) ---
DEV_POSTGRES_URL=postgresql://dev:devpass123@postgres-dev:5432/dev
STAGING_POSTGRES_URL=postgresql://staging:stagingpass@postgres-staging:5432/staging
DEV_NEO4J_URI=bolt://neo4j-dev:7687
DEV_NEO4J_AUTH=neo4j/devpass123
STAGING_NEO4J_URI=bolt://neo4j-staging:7687
STAGING_NEO4J_AUTH=neo4j/stagingpass

# --- Compose passwords (must match the migrated data volumes) ---
DEV_POSTGRES_PASSWORD=devpass123
STAGING_POSTGRES_PASSWORD=stagingpass
DEV_NEO4J_PASSWORD=devpass123
STAGING_NEO4J_PASSWORD=stagingpass
